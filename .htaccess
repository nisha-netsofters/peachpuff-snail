<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_authz_core.c>
  <FilesMatch "\.(json|js|png|ico|svg|webp|css|map|txt|webmanifest)$">
    Require all granted
  </FilesMatch>
</IfModule>
